{"nodes": [{"id": "php_run_cli_runner", "label": "run-cli.sh \u2014 site-agnostic CLI runner", "file_type": "code", "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only runner in the plugin not pinned to cb-test. Socket, the site's own PHP version and the expected domain are all resolved from Local's sites.json by the site that owns the checkout, so the same script runs on any Local site without edits."}, {"id": "php_run_cli_sites_query", "label": "sites_query() \u2014 read Local's sites.json", "file_type": "code", "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "php_run_cli_siteurl_guard", "label": "siteurl guard \u2014 domain must match Local's record", "file_type": "code", "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:214", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local names every database `local` and tells sites apart only by socket, so a successful connection proves nothing. The host of `option get siteurl` is compared against the domain Local has on record for the site that owns these files; a mismatch is the two-database trap and exits rather than running."}, {"id": "php_run_cli_cross_site_refusal", "label": "Cross-site --site refusal", "file_type": "code", "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naming a --site other than the one that owns the checkout would pair this copy's files with that site's database - the two-database trap in slow motion. Refused outright."}, {"id": "php_run_cli_smoke_mode", "label": "--smoke \u2014 read-only commands only", "file_type": "code", "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:260", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "diagnostics, stats, logs and optimize --dry-run write nothing, so they are safe on an unfamiliar or production-shaped site. The right first thing to run before letting the bulk harness near a library."}], "edges": [{"source": "php_run_cli_runner", "target": "php_cli_bulk_e2e_harness", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:283", "weight": 1.0}, {"source": "php_run_cli_runner", "target": "php_run_cli_sites_query", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:36", "weight": 1.0}, {"source": "php_run_cli_runner", "target": "php_run_cli_siteurl_guard", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:214", "weight": 1.0}, {"source": "php_run_cli_runner", "target": "php_run_cli_cross_site_refusal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:163", "weight": 1.0}, {"source": "php_run_cli_runner", "target": "php_run_cli_smoke_mode", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:260", "weight": 1.0}, {"source": "php_run_cli_siteurl_guard", "target": "fix_plan_two_database_trap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:20", "weight": 1.0}, {"source": "php_run_cli_cross_site_refusal", "target": "fix_plan_two_database_trap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/run-cli.sh", "source_location": "tests/php/run-cli.sh:163", "weight": 1.0}], "hyperedges": [{"id": "refuse_rather_than_guess", "label": "Guards that refuse rather than guess", "nodes": ["php_cli_dirty_library_guard", "php_run_cli_siteurl_guard", "php_run_cli_cross_site_refusal", "fix_plan_two_database_trap", "fix_plan_backup_incident"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "tests/php/run-cli.sh"}]}