{"nodes": [{"id": "tests_web_runner", "label": "web-runner.php token-gated web PHP suite runner", "file_type": "code", "source_file": "tests/php/web-runner.php", "source_location": "1-92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_web_runner_rationale", "label": "Why web-runner.php exists", "file_type": "concept", "source_file": "tests/php/web-runner.php", "source_location": "1-23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "web-runner.php lets the harness suites run under the site's web PHP (php-fpm) instead of CLI PHP, because CLI PHP on this environment lacks the Imagick extension while the site's web PHP has it. A CLI-only run would silently fall back to cwebp regardless of the engine requested, which is how the cwebp portrait-rotation bug (issue I-2) reached production without being caught."}], "edges": [{"source": "tests_web_runner", "target": "tests_rewriter_test_suite", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/web-runner.php", "source_location": "57-92", "weight": 1.0}, {"source": "tests_web_runner", "target": "tests_convert_restore_e2e_suite", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/web-runner.php", "source_location": "57-92", "weight": 1.0}, {"source": "tests_web_runner", "target": "tests_bulk_e2e_suite", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/web-runner.php", "source_location": "57-92", "weight": 1.0}, {"source": "concept_web_runner_rationale", "target": "tests_web_runner", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/web-runner.php", "source_location": "1-23", "weight": 1.0}], "hyperedges": []}