{"nodes": [{"id": "php_cli_bulk_e2e_harness", "label": "cli-bulk-e2e.php \u2014 WP-CLI bulk harness", "file_type": "code", "source_file": "tests/php/cli-bulk-e2e.php", "source_location": "tests/php/cli-bulk-e2e.php:1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closes I-4 with 42 assertions. Drives the real `wp` binary through proc_open rather than calling Commands methods directly, because the untested surface was never the conversion - it was the flag parsing, the clamps and the WP_CLI::error exit codes, none of which exist when the method is called in-process."}, {"id": "php_cli_run", "label": "cli_run() \u2014 invoke wp as a subprocess", "file_type": "code", "source_file": "tests/php/cli-bulk-e2e.php", "source_location": "tests/php/cli-bulk-e2e.php:88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "php_cli_binaries", "label": "cli_binaries() \u2014 resolve php, wp, socket, path, url", "file_type": "code", "source_file": "tests/php/cli-bulk-e2e.php", "source_location": "tests/php/cli-bulk-e2e.php:50", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "php_cli_dirty_library_guard", "label": "Dirty-library refusal (SIO_CLI_ALLOW_DIRTY)", "file_type": "code", "source_file": "tests/php/cli-bulk-e2e.php", "source_location": "tests/php/cli-bulk-e2e.php:170", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "optimize --all and restore --all act on the whole media library, not on the harness's own fixtures. On a site with real media that is an unattended bulk edit of user data, so the harness counts pre-existing pending and restorable rows and exits 2 unless both are zero."}], "edges": [{"source": "php_cli_bulk_e2e_harness", "target": "php_cli_run", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/php/cli-bulk-e2e.php", "source_location": "tests/php/cli-bulk-e2