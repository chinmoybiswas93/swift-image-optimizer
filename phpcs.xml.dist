<?xml version="1.0"?>
<ruleset name="Swift Image Optimizer">
	<description>Coding standards for the Swift Image Optimizer plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/resources/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-Extra">
		<!--
			The framework-shaped layer (app/Foundation, app/Http, app/Models,
			boot/, config/) is written in the PSR-12 / camelCase style the
			structure is modelled on, not WordPress's. The security, escaping
			and database sniffs still apply everywhere - only the cosmetic
			naming and formatting rules are dropped, and only there.
		-->
		<exclude name="WordPress.NamingConventions.ValidFunctionName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="WordPress.Arrays.ArrayIndentation"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress-Docs">
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
	</rule>

	<!-- Text domain must match the plugin slug. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="swift-image-optimizer"/>
			</property>
		</properties>
	</rule>

	<!-- Every global symbol must carry the plugin prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="swift_image_optimizer"/>
				<element value="SWIFT_IMAGE_OPTIMIZER"/>
				<element value="SwiftImageOptimizer"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum supported versions. -->
	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
